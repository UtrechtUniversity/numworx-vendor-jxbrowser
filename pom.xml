<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>nl.uu.fi.dwo</groupId>
		<artifactId>DWO.master.pom</artifactId>
		<version>1.1</version>
	</parent>
	<groupId>nl.numworx.swingbrowser</groupId>
	<artifactId>swingbrowser-parent</artifactId>
	<version>0.0.11</version>
	<packaging>pom</packaging>
	<name>SwingBrowser Multi module</name>
	<modules>
		<module>swingbrowser-api</module>
		<module>swingbrowser-jfx</module>
		<module>swingbrowser-jxb</module>
		<module>swingbrowser-ext</module>
	</modules>
	<properties>
		<maven.compiler.source>1.8</maven.compiler.source>
		<maven.compiler.target>1.8</maven.compiler.target>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.build.timestamp.format>yyyyMMddHHmm</maven.build.timestamp.format>
		<osgi.qualifier>${maven.build.timestamp}</osgi.qualifier>
	</properties>
	<build>
		<plugins>
			<plugin>
				<groupId>external.atlassian.jgitflow</groupId>
				<artifactId>jgitflow-maven-plugin</artifactId>
				<version>1.0-m5.1</version>
			</plugin>
		</plugins>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.felix</groupId>
					<artifactId>maven-bundle-plugin</artifactId>
					<version>2.5.3</version>
					<extensions>true</extensions>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>
	<description>api voor swingbrowser bundles</description>
	<organization>
		<name>Numworx</name>
		<url>https://www.numworx.nl</url>
	</organization>
	<inceptionYear>2019</inceptionYear>
	<scm>
		<developerConnection>scm:git:git@git.science.uu.nl:dwoproject/application/swingbrowser.git</developerConnection>
	</scm>
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>nl.numworx.swingbrowser</groupId>
				<artifactId>swingbrowser-api</artifactId>
				<version>0.0.11</version>
			</dependency>
		</dependencies>
	</dependencyManagement>
</project>
